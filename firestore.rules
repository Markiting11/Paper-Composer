rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Path Variable Hardening
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrap Admin check
    function isBootstrapAdmin() {
      return isSignedIn() && 
             request.auth.token.email.lower() == 'arshad2097@gmail.com' && 
             isEmailVerified();
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 200 &&
             data.role in ['ADMIN', 'USER'] &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.createdAt is string;
    }

    function isValidExamPaper(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.data is map &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    function isValidGlobalConfig(data) {
      return data.signupEnabled is bool;
    }

    // ---------------------------------------------------------
    // COLLECTIONS
    // ---------------------------------------------------------

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && 
                      isValidId(userId) && isValidUser(incoming()) &&
                      (
                        (isBootstrapAdmin() && incoming().role == 'ADMIN' && incoming().status == 'APPROVED') ||
                        (incoming().role == 'USER' && incoming().status == 'PENDING')
                      );
      
      allow update: if isSignedIn() && (
        // Admin can update everything
        (isAdmin() && isValidUser(incoming())) ||
        // User can only update their own non-RBAC fields (none currently defined, but skeleton below)
        (isOwner(userId) && isValidUser(incoming()) && 
         incoming().role == existing().role && 
         incoming().status == existing().status &&
         incoming().createdAt == existing().createdAt &&
         incoming().diff(existing()).affectedKeys().hasOnly(['email']))
      );

      allow delete: if isAdmin();
    }

    match /examPapers/{paperId} {
      // 8. Secure List Queries: Explicitly evaluate resource.data.userId
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidId(paperId) && isValidExamPaper(incoming()) &&
                      incoming().userId == request.auth.uid;
      
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) &&
                      isValidExamPaper(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt;

      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /config/global {
      allow read: if true;
      allow write: if isAdmin() && isValidGlobalConfig(incoming());
    }

  }
}
